#!/bin/sh
set -e

printf '\n  OwlShot installed to /usr/bin/owlshot\n\n'

# GNOME 自定义快捷键无法通过 postinst 自动配置：
# dconf 直写不经过 gsettings schema，GNOME media-keys 读不到。
# 必须通过「设置 → 键盘 → 自定义快捷键」GUI 添加，或执行下面的脚本。

printf '  ═══════════════════════════════════════════════════\n'
printf '  GNOME 快捷键绑定（仅 GNOME 桌面需要）：\n\n'
printf '  1. 打开「设置 → 键盘 → 自定义快捷键」\n'
printf '  2. 点击「添加」\n'
printf '     名称：OwlShot 框选截图\n'
printf '     命令：/usr/bin/owlshot --region\n'
printf '     快捷键：Ctrl+Alt+A\n\n'
printf '  3. （可选）再添加：\n'
printf '     名称：OwlShot 全屏截图\n'
printf '     命令：/usr/bin/owlshot --full\n'
printf '     快捷键：Ctrl+Alt+S\n\n'
printf '  4. （可选）添加历史回溯：\n'
printf '     名称：OwlShot 上一张      命令：/usr/bin/owlshot --history 1  快捷键：Ctrl+Alt+1\n'
printf '     名称：OwlShot 上上张      命令：/usr/bin/owlshot --history 2  快捷键：Ctrl+Alt+2\n'
printf '     名称：OwlShot 上上上张    命令：/usr/bin/owlshot --history 3  快捷键：Ctrl+Alt+3\n\n'
printf '  5. （可选）贴图功能：\n'
printf '     名称：OwlShot 贴图\n'
printf '     命令：/usr/bin/owlshot --paste\n'
printf '     快捷键：Ctrl+Shift+V\n'
printf '  ═══════════════════════════════════════════════════\n\n'

printf '  ═══════════════════════════════════════════════════\n'
printf '  截图提示音（可选）：\n\n'
printf '  截图时的“咔嚓”声由 GNOME 的 screen-capture 系统声音事件播放，\n'
printf '  并非 OwlShot 发出，应用层无法单独静音。如需关闭：\n\n'
printf '  关闭（会连带关掉其它系统提示音）：\n'
printf '     gsettings set org.gnome.desktop.sound event-sounds false\n\n'
printf '  恢复：\n'
printf '     gsettings reset org.gnome.desktop.sound event-sounds\n'
printf '  ═══════════════════════════════════════════════════\n\n'

printf '  Recommended: sudo apt install wl-clipboard\n\n'
