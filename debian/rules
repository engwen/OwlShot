#!/usr/bin/make -f
PREFIX := debian/owlshot
DEB_PKG := owlshot_0.1.4_amd64.deb

.PHONY: build install package clean

build:
	cargo build --release --locked

install: build
	rm -rf $(PREFIX)
	mkdir -p $(PREFIX)/DEBIAN
	install -d $(PREFIX)/usr/bin
	install -d $(PREFIX)/usr/share/applications
	install -d $(PREFIX)/usr/share/icons/hicolor/128x128/apps
	install -m 755 target/release/owlshot $(PREFIX)/usr/bin/owlshot
	install -m 644 owlshot.desktop $(PREFIX)/usr/share/applications/owlshot.desktop
	install -m 644 assets/icons/owlshot.png $(PREFIX)/usr/share/icons/hicolor/128x128/apps/owlshot.png
	cp debian/control $(PREFIX)/DEBIAN/control
	test ! -f debian/postinst || install -m 755 debian/postinst $(PREFIX)/DEBIAN/postinst
	test ! -f debian/prerm || install -m 755 debian/prerm $(PREFIX)/DEBIAN/prerm
	test ! -f debian/postrm || install -m 755 debian/postrm $(PREFIX)/DEBIAN/postrm

package: install
	dpkg-deb --build --root-owner-group $(PREFIX) $(DEB_PKG)
	@echo ""
	@echo "=== 包已生成：$(DEB_PKG) ($$(du -sh $(DEB_PKG) | cut -f1)) ==="
	@echo "安装：sudo dpkg -i $(DEB_PKG)"

clean:
	cargo clean
	rm -rf $(PREFIX) $(DEB_PKG)
